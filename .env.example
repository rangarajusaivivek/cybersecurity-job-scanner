# ─────────────────────────────────────────────────────────────
# job_scanner/.env.example
# Copy to .env and fill in your keys. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Anthropic (for AI email generation + job scoring)
# Get free at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Hunter.io (find hiring manager emails — 25 free/month)
# Get at: hunter.io/users/sign_up
HUNTER_API_KEY=...

# SendGrid (send digest emails — free 100 emails/day)
# Get at: sendgrid.com
SENDGRID_API_KEY=SG....

# Telegram Bot (alternative/additional notification channel)
# Create bot: message @BotFather on Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Optional: Google Sheets (for application tracking)
GOOGLE_SHEETS_ID=...
GOOGLE_SERVICE_ACCOUNT_JSON=config/google_service_account.json
